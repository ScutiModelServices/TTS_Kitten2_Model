# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat loads it for a local run (it passes --dotenv and prints the variable names it loaded); a real environment variable wins.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env.

# Admin password: unlocks /admin/, where you create a token per caller; callers send theirs as X-Internal-Token.
# Voices are added with the admin password too. Empty = no auth at all (local use only).
SERVICE_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
SERVICE_PORT=29323

# Compose only: API copies behind nginx. Each copy loads the 1.7B model on the CPU (about 6 GB of RAM each, measured).
SERVICE_REPLICAS=1

# Compose only: RAM cap per replica (e.g. 8g); 0 = no cap. A cap keeps an out-of-memory kill inside the container.
# SERVICE_MEM_LIMIT=0

# CPU threads for the model. Set the physical core count, not the logical one.
# A value saved on the /admin/ page beats this one. Applies live, no restart.
# SERVICE_NUM_THREAD=6

# Tunables (update check hours, in-flight cap, answers kept, model revision, device, weight variant, decoder, token
# limit, load at start) are set on the /admin/ Settings card and saved in settings.json. These variables are only a
# starting value for run.bat; compose does not pass them. A saved value wins.
# SERVICE_UPDATE_CHECK_HOURS=6
# SERVICE_MAX_INFLIGHT=
# SERVICE_MODEL_REVISION=c93cb7c271baa51d9ae8204d5277988906f235a2
# SERVICE_DEVICE=cpu
# SERVICE_WEIGHTS=packed
# SERVICE_DECODER=default
# SERVICE_WARM=1

# run.bat only (compose sets these itself): bind address.
# SERVICE_HOST=127.0.0.1
# Where tokens are stored (hashed), the cloned voices and the admin page folder. Docker sets /data/tokens.json,
# /voices and /app/web.
# SERVICE_TOKENS_FILE=tokens.json
# SERVICE_VOICES_DIR=_voices
# SERVICE_WEB_DIR=web
